  "cards": [
    {
      "dot": "cyan",
      "title": "Werkzeug im Repo",
      "items": [
        "build.py liest den Bestand ohne Urteil, codex.py denselben aus ~/.codex",
        "werkzeuge.py prüft Laufzeiten und MCP-Server aus Quellcode, nur zur Anzeige",
        "server.py liefert aus und führt die gewählten Aktionen aus; die Seite gibt es nur mit dem Schlüssel des laufenden Servers",
        "template.html ist die Oberfläche, Farben nur aus dem 3zero-Brand-Kit"
      ]
    },
    {
      "dot": "emerald",
      "title": "Datenordner",
      "items": [
        "Bewertung: Handarbeit, teuer neu zu erzeugen",
        "Inventar, Dashboard, Verlauf und werkzeuge.json: erzeugt, jederzeit neu baubar",
        "harness.json merkt den zuletzt gestarteten Harness",
        "start.html gibt es nur, solange der Server läuft: Sie trägt den Schlüssel und ist nur für dich lesbar"
      ]
    },
    {
      "dot": "amber",
      "title": "Warum getrennt",
      "items": [
        "Die Bewertung beschreibt deinen Rechner, nicht das Werkzeug",
        "Seit der Trennung schreibt nichts mehr in den Projektordner",
        "~/.agents liest jeder Harness, deshalb steht ein Skill in beiden Bewertungen"
      ]
    }
  ]
